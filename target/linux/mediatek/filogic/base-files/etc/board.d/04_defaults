. /lib/functions/uci-defaults.sh

board=$(board_name)

board_config_update

case $board in
openwrt,one)
	ucidef_set_wireless_mac_count 2g 7
	ucidef_set_wireless_mac_count 5g 7
	;;
livinet,li323|\
livinet,li323-ubootmod)
	ucidef_set_country "CN"
	ucidef_set_wireless "all" "OpenWrt" "none"
	;;
esac

board_config_flush

exit 0
